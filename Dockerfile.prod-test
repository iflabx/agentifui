FROM node:24.22.2-bookworm-slim

WORKDIR /app

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN npm install --global --ignore-scripts pnpm@10.34.9

COPY . .

RUN pnpm install --frozen-lockfile
ARG NEXT_PUBLIC_BRAND_NAME
ARG NEXT_PUBLIC_BRAND_DOMAIN
RUN pnpm build:all

EXPOSE 3000 3010

CMD ["pnpm", "start:prod"]
