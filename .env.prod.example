# Production runtime profile (copy to .env.prod and fill secrets).

NODE_ENV=production
# Stable directory outside every release. First install only: AGENTIF_RUNTIME_INIT=1 pnpm run deploy.
AGENTIF_RUNTIME_DIR=/path/to/agentifui/runtime/prod
PORT=3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
BETTER_AUTH_URL=http://127.0.0.1:3000
# Optional public branding (set before building; use the same values for Web and API).
# NEXT_PUBLIC_BRAND_NAME="Example Assistant"
# NEXT_PUBLIC_BRAND_DOMAIN=chat.example.com

# Data services (prod isolation: use dedicated DB/Redis/Bucket)
DATABASE_URL=postgresql://agentif_app:agentif_app@127.0.0.1:5432/agentifui_prod
MIGRATOR_DATABASE_URL=postgresql://agentif:agentif@127.0.0.1:5432/agentifui_prod
APP_DATABASE_ROLE=agentif_app
APP_DATABASE_PASSWORD=replace_with_strong_password
APP_RLS_STRICT_MODE=1

REDIS_URL=redis://127.0.0.1:6379/1
REDIS_PREFIX=agentifui-prod

S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=agentifui-prod
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_ENABLE_PATH_STYLE=1
# Optional: HTTPS endpoint reachable by browsers; preserve signed Host and object paths at the proxy
# S3_PRESIGN_ENDPOINT=https://storage.example.com
# S3_PUBLIC_BASE_URL=https://storage.example.com/agentifui-prod

# Required secrets (must differ from dev values)
# Authentication email: configure both modes and an authorized sender for SMTP.
# AUTH_EMAIL_VERIFICATION_MODE=smtp
# AUTH_RESET_PASSWORD_MODE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=mailer-account
# SMTP_PASSWORD=replace_with_smtp_credential
# SMTP_FROM="AgentifUI <no-reply@example.com>"

BETTER_AUTH_ENABLED=true
AUTH_BACKEND=better-auth
BETTER_AUTH_SECRET=replace_with_32_plus_random_chars
# Enable only after configuring the server-side GitHub OAuth credentials.
NEXT_PUBLIC_GITHUB_LOGIN_ENABLED=false
# GITHUB_CLIENT_ID=replace_with_oauth_app_client_id
# GITHUB_CLIENT_SECRET=replace_with_oauth_app_client_secret
# Generate a private key with: openssl rand -hex 32
API_ENCRYPTION_KEY=CHANGE_ME

# Optional: total multipart request limit for Dify file/audio uploads (16 MiB by default)
# DIFY_UPLOAD_MAX_BYTES=16777216
# Dify temp config (admin-only; disabled by default)
# DIFY_TEMP_CONFIG_ENABLED=0
# DIFY_TEMP_CONFIG_ALLOWED_HOSTS=dify.example.com,*.dify.internal
# DIFY_TEMP_CONFIG_ALLOW_PRIVATE=0
# Dify input moderation gate (Fastify proxy; fail-closed when enabled)
# DIFY_INPUT_MODERATION_ENABLED=0
# DIFY_INPUT_MODERATION_APP={"apiUrl":"https://your-dify-host/v1","apiKey":"app-xxxxxxxxxxxxxxxx"}

# Fastify sidecar + Next rewrite bridge
FASTIFY_PROXY_ENABLED=1
FASTIFY_PROXY_BASE_URL=http://127.0.0.1:3010
# Optional override. If set manually, keep this list aligned with .env.example.
# FASTIFY_PROXY_PREFIXES=/api/dify,/api/content,/api/internal/data,/api/internal/apps,/api/internal/profile,/api/internal/error-events/client,/api/internal/realtime,/api/internal/storage,/api/internal/ops/dify-resilience,/api/internal/dify-config,/api/internal/fastify-health,/api/admin,/api/translations
FASTIFY_API_HOST=0.0.0.0
FASTIFY_API_PORT=3010
NEXT_UPSTREAM_BASE_URL=http://127.0.0.1:3000

# CORS
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Docker Compose only (see docs/DOCKER.md). This file is parsed as dotenv,
# not sourced by a shell. Use private, independent random hex passwords.
# AGENTIF_IMAGE=agentifui:local
# SOURCE_COMMIT=full_source_commit
# COMPOSE_PROJECT_NAME=agentifui
# WEB_BIND_IP=127.0.0.1
# WEB_PORT=3000
# POSTGRES_DB=agentifui
# POSTGRES_USER=agentif_owner
# POSTGRES_PASSWORD=replace_with_48_random_hex_chars
# APP_DATABASE_ROLE=agentif_app
# APP_DATABASE_PASSWORD=replace_with_different_48_random_hex_chars
# DATABASE_URL=postgresql://agentif_app:APP_PASSWORD@postgres:5432/agentifui
# MIGRATOR_DATABASE_URL=postgresql://agentif_owner:OWNER_PASSWORD@postgres:5432/agentifui
# REDIS_PASSWORD=replace_with_different_48_random_hex_chars
# REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/1
# MINIO_ROOT_USER=agentif_owner
# MINIO_ROOT_PASSWORD=replace_with_different_48_random_hex_chars
# AGENTIF_MINIO_IMAGE=agentifui-minio:source-9e49d5e7
# AGENTIF_MC_IMAGE=agentifui-mc:source-7394ce0d
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY_ID=agentif_storage
# S3_SECRET_ACCESS_KEY=replace_with_different_48_random_hex_chars
# S3_PRESIGN_ENDPOINT=https://storage.example.com
# STORAGE_BIND_IP=127.0.0.1
# STORAGE_PORT=9000
# Docker fixes AGENTIF_RUNTIME_DIR=/data/runtime and strict RLS internally;
# bridge addresses are defaults. Only explicit application variables are forwarded.
# Set both AUTH_*_MODE values to smtp and configure SMTP before public use.
# Optional host-network capacity uses the same file; see docs/DOCKER-CAPACITY.md.
# Set FASTIFY_PROXY_BASE_URL before building; it is recorded in the image label.
# FASTIFY_PROXY_BASE_URL=http://127.0.0.1:13010
# NEXT_UPSTREAM_BASE_URL=http://127.0.0.1:13000
# PG_POOL_MAX=5
# Cache/realtime keys and channels default to namespaced REDIS_PREFIX values.
