FROM golang:1.24.8-bookworm AS builder
ENV CGO_ENABLED=0 \
    GOBIN=/out \
    GOMODCACHE=/go/pkg/mod \
    GOCACHE=/root/.cache/go-build \
    GOTOOLCHAIN=local
ENV MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a \
    MC_COMMIT=7394ce0dd2a80935aded936b09fa12cbb3cb8096
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eu; \
    go install "github.com/minio/minio@$MINIO_COMMIT"; \
    go install "github.com/minio/mc@$MC_COMMIT"; \
    minio_dir="$(go list -m -f '{{.Dir}}' "github.com/minio/minio@$MINIO_COMMIT")"; \
    mc_dir="$(go list -m -f '{{.Dir}}' "github.com/minio/mc@$MC_COMMIT")"; \
    test -n "$minio_dir"; \
    test -n "$mc_dir"; \
    test -s "$minio_dir/LICENSE"; \
    test -s "$mc_dir/LICENSE"; \
    mkdir -p /out/licenses/minio /out/licenses/mc; \
    cp "$minio_dir/LICENSE" /out/licenses/minio/LICENSE; \
    cp "$mc_dir/LICENSE" /out/licenses/mc/LICENSE

FROM alpine:3.22 AS runtime
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ENV HOME=/tmp

FROM runtime AS minio
COPY --from=builder /out/minio /usr/local/bin/minio
COPY --from=builder /out/licenses/minio/LICENSE /usr/share/licenses/minio/LICENSE
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
    org.opencontainers.image.licenses="AGPL-3.0-or-later"
RUN mkdir -p /data && chown 1000:1000 /data
USER 1000:1000
WORKDIR /data
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]

FROM runtime AS mc
COPY --from=builder /out/mc /usr/local/bin/mc
COPY --from=builder /out/licenses/mc/LICENSE /usr/share/licenses/mc/LICENSE
LABEL org.opencontainers.image.source="https://github.com/minio/mc" \
    org.opencontainers.image.licenses="AGPL-3.0-or-later"
USER 0:0
ENTRYPOINT ["/usr/local/bin/mc"]
